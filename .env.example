# Copy to .env  (never commit .env, never paste keys in chat)
# cp .env.example .env

# Gemini (ideas, forensic, scripts — when we wire LLM)
GEMINI_API_KEY=

# YouTube Data API v3 — search / channel stats only
YOUTUBE_API_KEY=

# YouTube OAuth — upload drafts (optional, later)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# youtube-transcript.io — hosted transcripts (no yt-dlp needed)
# token from youtube-transcript.io/profile
YOUTUBE_TRANSCRIPT_IO_TOKEN=
